table sales
	lineageTag: dfed0b31-152e-4294-ac30-631b5c0bd521

	measure total_revenue = SUM(sales[discounted_price])
		lineageTag: e2f132dd-0657-42ac-b261-ced8b07f4684

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure total_units_sold = sum(sales[sale_quantity])
		formatString: 0
		lineageTag: 6452d98b-fe5a-4ba1-9351-f02b50410464

	measure discounted_revenue = ```
			
			SUMX(sales, 
			sales[sale_quantity] * 
			sales[discounted_price])
			```
		lineageTag: f7f98e38-5958-4c9c-b8b5-b036127d92ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure revenue_in_feb =
			
			CALCULATE(
			    sales[discounted_revenue],
			    dates[date] >= date(2025,02,01),
			    dates[date] <= date(2025,02,28)
			)
		lineageTag: 0179a947-5646-40bb-b81b-e70e1f6ac8d1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

